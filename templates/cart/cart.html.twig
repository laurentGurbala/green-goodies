{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Mon panier{% endblock %}

{% block body %}
<main class="cart-container">

    <section class="cart">
        <h1 class="cart__title">Mon panier</h1>

        <!-- Article du panier -->
        {% if cart.cartItems is not empty %}
        <a href="{{ path('cart_clear')}}" class="cart-empty-link"
            onclick="return confirm('Etes-vous sûr de vouloir vider votre panier ?')">x Vider le panier</a>
        {% endif %}

        <div class="product-container">
            {% if cart.cartItems is empty %}
            <p class="cart__info">Votre panier est vide.</p>
            {% else %}
                {% for item in cart.getCartItems %}
                <div class="card-product">
                    <img src="{{ asset('uploads/products/' ~ item.product().picture) }}" alt="{{ item.product.name }}">
                    <div class="card-product__info">
                        <p class="card-product__title">{{ item.product.name }}</p>
                        <p class="card-product__quantity">Quantité: {{ item.quantity }}</p>
                        <p class="card-product__price">{{ item.product.price }} €</p>
                    </div>
                </div>
                {% endfor %}
            {% endif %}
        </div>

        <!-- Total du panier -->
        <div class="cart-total">
            <p class="cart-total__info">Total panier : <span class="cart-total__price">{{ total|number_format(2, ',', ' ') }}€</span></p>
            <p class="cart-total__delivery">Frais de livraison: Offert</p>
        </div>

        {% if cart.cartItems is not empty %}
            <div class="cart-confirm">
                <a href="{{ path('cart_validate') }}" class="btn">Valider la commande</a>
            </div>
        {% endif %}
    </section>
</main>
{% endblock %}