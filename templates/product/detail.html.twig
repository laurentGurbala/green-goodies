{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} {{ product.name }}{% endblock %}

{% block body %}
<main>
    <section class="product-detail">
        <!-- Image du produit -->
        <div class="product-detail__left">
            <img src="{{ asset('uploads/products/' ~ product.picture)}}" alt="{{ product.name}}" class="product-detail__picture">
        </div>

        <!-- Détail du produit -->
        <div class="product-detail__right">
            <div class="product-detail__content">
                <h1 class="product-detail__title">{{ product.name }}</h1>
                <p class="product-detail__price">{{ product.price }}€</p>
                <p class="product-detail__subtitle">Description</p>
                <p class="product-detail__description {% if app.user%}product-detail__description--login{% endif %}">{{ product.fullDescription }}</p>
                
                {% if app.user %}
                <form action="#" method="post" class="product-form">
                    <div class="product-form__line">
                        <label for="quantity">Quantité :</label>
                        <input type="number" id="quantity" name="quantity" value="1" min="0" required>
                    </div>
                    <button type="submit" class="btn">Ajouter au panier</button>
                </form>
                {% else %}
                    <a href="{{ path('app_login') }}" class="btn">Se connecter</a>
                {% endif %}
            </div>
        </div>

    </section>
</main>
{% endblock %}
