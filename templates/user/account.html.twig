{% extends 'base.html.twig' %}

{% block title %}Mon compte{% endblock %}

{% block body %}
<main class="account-container">
    <section class="account">
        <h1 class="account__title">Mon compte</h1>

        <!-- Historique des commandes -->
        <div class="account-order">
            <h2 class="account-order__title">Mes commandes</h2>

            {% if orders is empty %}
            <p>Vous n'avez pas encore passé de commande.</p>
            {% else %}
            <!-- Tableau -->
            <table class="account-table">
                <!-- en-tête -->
                <thead>
                    <tr>
                        <th>N°</th>
                        <th>Date</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <!-- corps -->
                <tbody>
                    {% for order in orders %}
                    <tr>
                        <td>{{ order.id }}</td>
                        <td>{{ order.createdAt|date('d/m/Y') }}</td>
                        <td>{{ order.total|number_format(2, ',', ' ') }}€</td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
            {% endif %}
        </div>

        <!-- Accès à l'API -->
        <div class="account-api">
            <h2 class="account-api__title">Mon accès API</h2>
            {% if app.user.isApiActivated %}
                <a href="{{ path('account_api_disable') }}" class="btn">Désactiver mon accès API</a>
            {% else %}
                <a href="{{ path('account_api_enable') }}" class="btn">Activer mon accès API</a>
            {% endif %}
        </div>

        <!-- Suppression de compte -->
        <div class="account-delete">
            <a href="#" class="btn">Supprimer mon compte</a>
        </div>
    </section>
</main>
{% endblock %}