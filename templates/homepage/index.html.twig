{% extends 'base.html.twig' %}

{% block title %}{{ parent() }} Accueil{% endblock %}

{% block body %}
<main>
    <!-- Welcome Banner -->
    <section class="welcome-banner">
        <div class="welcome-banner__text">
            <h1 class="welcome-banner__title">Bienvenue</h1>
            <div class="welcome-banner__content">
                <p>Découvrez notre univers de produits durables et éthiques pour une consommation responsable</p>
                <p>Retrouvez des articles d'hygiène & beauté, des accessoires & boissons et du prêt <br>à porter</p>
            </div>
        </div>
        <div class="welcome-banner__picture">
            <img src="{{ asset('uploads/website/welcome-picture.jpg')}}"
                alt="Des écritaux montrant l'engagement de Green Goodies envers l'environnement">
        </div>
    </section>

    <!-- Nos Produits -->
    <section class="products">
        <h2 class="products__title">Nos Produits</h2>

        <div class="products-grid">
            {% for product in products %}
            <div class="product-card">
                <div class="product-card__picture">
                    <img src="{{ asset('uploads/products/' ~ product.picture)}}" alt="{{ product.name}}">
                </div>
                <div class="product-card__content">
                    <h3 class="product-card__name">{{ product.name }}</h3>
                    <p class="product-card__shortDesc">{{ product.shortDescription }}</p>
                    <p class="product-card__price">{{ product.price }} €</p>
                    <a class="btn btn--product" href="#">voir le produit</a>
                </div>
            </div>
            {% endfor %}
        </div>
    </section>

    <!-- Notre Conviction -->
    <section class="conviction">
        <div class="conviction-left">
            <h2 class="conviction__title">notre conviction</h2>
            <p class="conviction__content">
                Chez GreenGoodies, nous croyons en un monde où le commerce peut être synonyme de bien-être pour la
                planète et ses habitants.
                Notre mission est de vous proposer une sélection rigoureuse de produits qui allient qualité, durabilité
                et éthique
            </p>
        </div>
        <div class="conviction-right">
            <img src="{{ asset('uploads/website/conviction.jpg')}}" alt="Une branche de fleur"
                class="conviction__picture">
        </div>
    </section>

    <!-- Nos Valeurs -->
    <section class="valeurs">
        <div class="valeurs-left">
            <img src="{{ asset('uploads/website/valeurs-picture.jpg')}}" alt="Sac en plastique noué" class="valeurs__picture">
        </div>
        <div class="valeurs-right">
            <h2 class="valeurs__title">nos valeurs</h2>
            <p class="valeurs__content">
                Durabilité : Nous sélectionnons soigneusement des produits qui respectent l'environnement et favorisent 
                la durabilité.<br>
                Éthique : Nous nous engageons à travailler avec des partenaires et des fournisseurs qui partagent nos
                valeurs éthiques.<br>
                Écologie : Nous encourageons des pratiques respectueuses de l'écosystème et privilégions les matériaux
                écologiques.
            </p>
        </div>
    </section>
</main>
{% endblock %}